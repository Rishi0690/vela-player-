<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="Selection" app:iconSpaceReserved="false">
        <Preference app:key="long_press_info" app:title="Long-press on a video" app:summary="Selects the video. Long-press a selected video again to open its options, or tap ⋮ anytime." app:selectable="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="Playlists" app:iconSpaceReserved="false">
        <ListPreference app:key="playlist_add_at" app:title="Add new videos to" app:entries="@array/add_at_entries" app:entryValues="@array/add_at_values" app:defaultValue="end" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <Preference app:key="dup_info" app:title="Duplicates" app:summary="A video that's already in a playlist is never added twice; you'll see how many were skipped." app:selectable="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
