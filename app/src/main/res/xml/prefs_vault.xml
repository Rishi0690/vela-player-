<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="Hidden Vault" app:iconSpaceReserved="false">
        <Preference app:key="vault_open" app:title="Open Hidden Vault" app:summary="Private videos hidden from the library. Authentication required." app:icon="@drawable/vault_ic_hide" />
        <Preference app:key="vault_security" app:title="Vault security" app:summary="PIN, pattern or fingerprint / biometric" app:icon="@drawable/ic_lock" />
        <ListPreference app:key="vault_lock_after" app:title="Lock after inactivity" app:entries="@array/vault_lock_entries" app:entryValues="@array/vault_lock_values" app:defaultValue="5" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="About hiding" app:iconSpaceReserved="false">
        <Preference app:key="vault_info" app:selectable="false" app:title="Files are not encrypted" app:summary="Hiding only removes videos from Vela. Files are not encrypted and stay visible in other apps and file managers. The vault always locks when you close it or leave the app." app:icon="@drawable/ic_info" />
    </PreferenceCategory>
</PreferenceScreen>
