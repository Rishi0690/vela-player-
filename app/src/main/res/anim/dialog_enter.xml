<!-- v2.12: dialogs float in: rise 4%, settle from 92% scale and fade, on the emphasized curve. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:duration="280" android:interpolator="@anim/emphasized">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1" android:pivotX="50%" android:pivotY="50%" />
    <translate android:fromYDelta="4%" android:toYDelta="0" />
</set>
