<!-- v2.6.1: calm "fade through": short slide + fade, new screen fades in once the old one is mostly gone. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:duration="260" android:startOffset="40"
    android:interpolator="@android:interpolator/linear_out_slow_in" android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <translate android:fromXDelta="6%" android:toXDelta="0" />
</set>
