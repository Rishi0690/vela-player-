    <scale android:fromXScale="1" android:toXScale="0.95" android:fromYScale="1" android:toYScale="0.95" android:pivotX="50%" android:pivotY="40%" />
    <translate android:fromXDelta="0" android:toXDelta="3%" />
</set>
