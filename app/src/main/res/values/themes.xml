<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vela" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/vela_light_status_bar</item>
        <item name="colorAccentSeed">@color/accent</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <!-- v2.13: glass multi-select bar (was the default flat M3 bar). -->
        <item name="actionModeBackground">@drawable/bg_action_mode</item>
        <item name="actionModeStyle">@style/Widget.Vela.ActionMode</item>
        <item name="android:windowAnimationStyle">@style/VelaWindowAnim</item>
        <item name="chipStyle">@style/VelaChip</item>
        <item name="bottomSheetDialogTheme">@style/VelaBottomSheet</item>
        <item name="materialAlertDialogTheme">@style/VelaDialog</item>
        <!-- v2.8: one scrollbar look for every native scrolling screen: slim accent thumb that fades after scrolling. -->
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarSize">4dp</item>
        <item name="android:scrollbarFadeDuration">300</item>
        <item name="android:scrollbarDefaultDelayBeforeFade">1000</item>
        <item name="android:scrollbarStyle">insideOverlay</item>
        <!-- v2.11 glass system: defaults (each theme overlay replaces them) + glass widget styles app-wide. -->
        <item name="glassSurface">@color/glass_surface</item>
        <item name="glassSurfaceStrong">@color/glass_surface_strong</item>
        <item name="glassStroke">@color/glass_stroke</item>
        <item name="glassHighlight">@color/glass_highlight</item>
        <item name="glassScrim">@color/glass_scrim</item>
        <item name="glassTint">@color/glass_tint</item>
        <!-- v2.19 floating glass (dialogs, sheets, popups over the Android 12+ window blur). -->
        <item name="glassFloat">@color/glass_float</item>
        <item name="glassFloatStroke">@color/glass_float_stroke</item>
        <item name="glassBlurWindows">true</item>
        <!-- v2.19: transient messages as floating glass too (theme text colours instead of the inverse M3 bar). -->
        <item name="snackbarStyle">@style/Widget.Vela.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.Vela.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/Widget.Vela.Snackbar.Button</item>
        <!-- v2.12 Midnight Glass tokens (defaults; each theme overlay replaces them). -->
        <item name="glassSurfaceElevated">@color/glass_surface_elevated</item>
        <item name="atmoTop">@color/atmo_top</item>
        <item name="atmoMid">@color/atmo_mid</item>
        <item name="atmoBottom">@color/atmo_bottom</item>
        <item name="atmoGlowA">@color/atmo_glow_a</item>
        <item name="atmoGlowB">@color/atmo_glow_b</item>
        <item name="navContainer">@color/nav_container</item>
        <item name="navSelected">@color/nav_selected</item>
        <item name="navOnSelected">@color/nav_on_selected</item>
        <item name="navText">@color/nav_text</item>
        <item name="android:windowBackground">@color/atmo_mid</item>
        <item name="materialCardViewStyle">@style/Widget.Vela.Glass.Card</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Vela.Glass.Button.Outlined</item>
        <item name="toolbarStyle">@style/Widget.Vela.Glass.Toolbar</item>
        <item name="floatingActionButtonStyle">@style/Widget.Vela.Fab</item>
        <item name="materialSwitchStyle">@style/Widget.Vela.Switch</item>
        <item name="preferenceTheme">@style/VelaPreferenceTheme</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Vela.Headline</item>
        <item name="popupMenuStyle">@style/Widget.Vela.Glass.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Vela.Glass.ListPopupWindow</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Vela.Glass.PopupMenu.Overflow</item>
        <!-- v2.21: toolbar / selection-bar icons a little narrower below 360dp (values-w360dp keeps 48dp) so every
             Home toolbar item (theme, search, grid/list, sort, ⋮) stays visible with room for the title. -->
        <item name="actionButtonStyle">@style/Widget.Vela.ActionButton</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Vela.ActionButton.Overflow</item>
        <item name="android:popupMenuStyle">@style/Widget.Vela.Glass.PopupMenu.Framework</item>
        <item name="android:listPopupWindowStyle">@style/Widget.Vela.Glass.ListPopupWindow.Framework</item>
        <item name="android:dropDownListViewStyle">@style/Widget.Vela.DropDownListView</item>
        <item name="android:spinnerStyle">@style/Widget.Vela.Spinner</item>
    </style>

    <style name="VelaWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nav_push_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/nav_push_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/nav_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/nav_pop_exit</item>
    </style>

    <!-- v2.6: iOS-style alert pop for dialogs. -->
    <style name="VelaDialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="VelaChip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearanceOverlay">@style/PillShape</item>
        <!-- v2.11: glass chip: translucent fill + hairline, soft accent glass when checked. -->
        <item name="chipBackgroundColor">@color/glass_chip_bg</item>
        <item name="chipStrokeColor">@color/glass_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
    </style>
    <style name="Widget.Vela.Glass.Chip" parent="VelaChip" />

    <style name="PillShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="VelaBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VelaBottomSheetStyle</item>
    </style>

    <style name="VelaBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/SheetShape</item>
        <!-- v2.11: glass sheet (near-opaque tinted; Android 12+ blurs the screen behind it). -->
        <item name="backgroundTint">?attr/glassSurfaceStrong</item>
    </style>

    <!-- v2.13 item options sheet (ItemSheet.kt): transparent sheet container, the floating glass card is drawn in code. -->
    <style name="VelaFloatingSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VelaFloatingSheetStyle</item>
        <item name="android:windowAnimationStyle">@style/VelaFloatingSheetAnim</item>
        <item name="android:backgroundDimAmount">@dimen/vela_dim_floating_flat</item>
    </style>
    <style name="VelaFloatingSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="shapeAppearance">@style/SheetShape</item>
    </style>
    <!-- Only the dim fades; the card itself floats in on a spring (ItemSheet). -->
    <style name="VelaFloatingSheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_fade_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_fade_out</item>
    </style>

    <style name="Widget.Vela.ActionMode" parent="Widget.Material3.ActionMode">
        <item name="background">@drawable/bg_action_mode</item>
        <item name="backgroundSplit">@drawable/bg_action_mode</item>
        <item name="titleTextStyle">@style/TextAppearance.Vela.ActionModeTitle</item>
    </style>
    <style name="TextAppearance.Vela.ActionModeTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- v2.11: glass dialog base (tinted near-opaque fill; VelaDialogBuilder adds the hairline border). -->
    <style name="VelaDialog.Base" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogShape</item>
        <item name="android:windowAnimationStyle">@style/VelaDialogAnim</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Vela</item>
    </style>
    <style name="VelaDialog" parent="VelaDialog.Base">
        <item name="android:backgroundDimAmount">@dimen/vela_dim_dialog_flat</item>
    </style>
    <style name="MaterialAlertDialog.Vela" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/glassSurfaceStrong</item>
        <item name="shapeAppearance">@style/DialogShape</item>
    </style>

    <!-- Player: no blur behind sheets/dialogs (blurring live video costs GPU and could stutter playback). -->
    <style name="VelaDialogPlain" parent="VelaDialog.Base" />
    <style name="VelaBottomSheetPlain" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VelaBottomSheetStyle</item>
    </style>

    <style name="DialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Theme.Vela.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccentSeed">@color/accent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/VelaWindowAnim</item>
        <item name="bottomSheetDialogTheme">@style/VelaBottomSheetPlain</item>
        <item name="materialAlertDialogTheme">@style/VelaDialogPlain</item>
        <!-- v2.11: player glass is always dark and never blurred (live video underneath). -->
        <item name="glassSurface">#14FFFFFF</item>
        <item name="glassSurfaceStrong">#EB141418</item>
        <item name="glassStroke">#24FFFFFF</item>
        <item name="glassHighlight">#1FFFFFFF</item>
        <item name="glassScrim">#99000000</item>
        <item name="glassTint">#1FFFFFFF</item>
        <item name="glassSurfaceElevated">#1CFFFFFF</item>
        <item name="navContainer">#D90B0E1E</item>
        <item name="navSelected">#F2F4FA</item>
        <item name="navOnSelected">#0D1122</item>
        <item name="navText">#9AA1B8</item>
        <item name="chipStyle">@style/VelaChip</item>
        <item name="materialCardViewStyle">@style/Widget.Vela.Glass.Card</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Vela.Glass.Button.Outlined</item>
        <item name="popupMenuStyle">@style/Widget.Vela.Glass.PopupMenu.Player</item>
        <item name="android:popupMenuStyle">@style/Widget.Vela.Glass.PopupMenu.FrameworkDark</item>
        <!-- v2.19: floating glass = the same fixed dark glass, and no window blur over live video. -->
        <item name="glassFloat">#EB141418</item>
        <item name="glassFloatStroke">#24FFFFFF</item>
        <item name="glassBlurWindows">false</item>
    </style>

    <style name="PlayerIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="PlayerBigIcon" parent="PlayerIcon">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="RoundedThumb">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ThemeSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- White player text with a soft shadow so it stays readable on bright scenes. -->
    <style name="PlayerText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#B3000000</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:shadowDy">1</item>
    </style>

    <!-- ===================== v2.11 glass widget styles ===================== -->
    <style name="GlassShapeCard">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="GlassShapeButton">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Vela.Glass.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/glassSurface</item>
        <item name="strokeColor">?attr/glassStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/GlassShapeCard</item>
    </style>

    <style name="Widget.Vela.Glass.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/glass_button_bg</item>
        <item name="strokeColor">@color/glass_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/glass_button_text</item>
        <item name="iconTint">@color/glass_button_icon</item>
    </style>
    <style name="Widget.Vela.Glass.Button.Tonal.Icon" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="backgroundTint">@color/glass_button_bg</item>
        <item name="strokeColor">@color/glass_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/glass_button_text</item>
        <item name="iconTint">@color/glass_button_icon</item>
    </style>
    <style name="Widget.Vela.Glass.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass_button_bg</item>
        <item name="strokeColor">@color/glass_button_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Vela.Glass.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- v2.19: every app popup (PopupMenu, toolbar / ActionMode overflow, ListPopupWindow, dropdowns) uses the floating
         glass drawable (frosted over the Android 12+ blur, near-opaque below). The player keeps .Player (unchanged). -->
    <style name="Widget.Vela.Glass.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/glass_popup_float</item>
    </style>
    <style name="Widget.Vela.Glass.PopupMenu.Player" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/glass_popup</item>
    </style>
    <style name="Widget.Vela.Glass.ListPopupWindow" parent="Widget.Material3.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/glass_popup_float</item>
    </style>
    <style name="Widget.Vela.Glass.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/glass_popup_float</item>
    </style>
    <style name="Widget.Vela.Glass.PopupMenu.Framework" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/glass_popup_float</item>
    </style>
    <style name="Widget.Vela.Glass.ListPopupWindow.Framework" parent="@android:style/Widget.Material.ListPopupWindow">
        <item name="android:popupBackground">@drawable/glass_popup_float</item>
    </style>
    <!-- Dropdown rows sit on the glass: no own background/divider so the frost shows through. -->
    <style name="Widget.Vela.DropDownListView" parent="@android:style/Widget.Material.ListView.DropDown">
        <item name="android:divider">@null</item>
        <item name="android:cacheColorHint">@android:color/transparent</item>
    </style>
    <style name="Widget.Vela.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/glass_popup_float</item>
    </style>

    <!-- v2.19 snackbar = floating glass (no blur is possible inside the window, so the near-opaque level 3). -->
    <style name="Widget.Vela.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/glassSurfaceStrong</item>
        <item name="shapeAppearance">@style/GlassShapeSnackbar</item>
    </style>
    <style name="GlassShapeSnackbar">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="Widget.Vela.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:alpha">1.0</item>
    </style>
    <style name="Widget.Vela.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.Vela.Glass.PopupMenu.FrameworkDark" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/glass_popup_dark</item>
    </style>

    <!-- ===================== v2.12 Midnight Glass components ===================== -->
    <!-- Floating pill navigation chip: no own background or stroke (PillNavGroup draws the sliding pill), medium label. -->
    <style name="Widget.Vela.NavPill.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearanceOverlay">@style/PillShape</item>
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="textStartPadding">6dp</item>
        <item name="textEndPadding">6dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Vela.NavPill</item>
        <item name="rippleColor">@color/nav_ripple</item>
    </style>
    <style name="TextAppearance.Vela.NavPill" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- Clean, slightly tighter headline for screen titles ("Vela Player"). -->
    <style name="TextAppearance.Vela.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:letterSpacing">-0.01</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Vela.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Floating action button: soft accent pill-circle with a low glow shadow, no heavy elevation. -->
    <style name="Widget.Vela.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">@dimen/vela_action_btn_min</item>
        <item name="android:paddingStart">@dimen/vela_action_btn_pad</item>
        <item name="android:paddingEnd">@dimen/vela_action_btn_pad</item>
    </style>
    <style name="Widget.Vela.ActionButton.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">@dimen/vela_action_overflow_min</item>
        <item name="android:paddingStart">@dimen/vela_action_overflow_pad_start</item>
        <item name="android:paddingEnd">@dimen/vela_action_overflow_pad_end</item>
    </style>

    <style name="Widget.Vela.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/PillShape</item>
        <item name="elevation">6dp</item>
        <item name="pressedTranslationZ">2dp</item>
        <item name="hoveredFocusedTranslationZ">2dp</item>
    </style>

    <!-- Switches: glass track when off, accent when on. -->
    <style name="Widget.Vela.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackDecorationTint">@color/glass_switch_decoration</item>
    </style>

    <!-- Preferences: transparent rows (the panel decoration draws the glass), section headers in small caps. -->
    <style name="VelaPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.Vela.Section</item>
    </style>

    <!-- Player: speed / aspect as small glass pills on the dock. -->
    <style name="Widget.Vela.PlayerPill" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="backgroundTint">#1FFFFFFF</item>
        <item name="strokeColor">#2EFFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/PillShape</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Glass sheet / dialog aliases (the real ones are VelaBottomSheet and VelaDialog above). -->
    <style name="Widget.Vela.Glass.Sheet" parent="VelaBottomSheetStyle" />
    <style name="Widget.Vela.Glass.Dialog" parent="MaterialAlertDialog.Vela" />
</resources>
