<resources>
    <style name="Theme.Vela" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="colorAccentSeed">@color/accent</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="android:windowAnimationStyle">@style/VelaWindowAnim</item>
        <item name="chipStyle">@style/VelaChip</item>
        <item name="bottomSheetDialogTheme">@style/VelaBottomSheet</item>
        <item name="materialAlertDialogTheme">@style/VelaDialog</item>
    </style>

    <style name="VelaWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/act_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/act_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/act_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/act_close_exit</item>
    </style>

    <style name="VelaChip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearanceOverlay">@style/PillShape</item>
    </style>

    <style name="PillShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="VelaBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VelaBottomSheetStyle</item>
    </style>

    <style name="VelaBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/SheetShape</item>
    </style>

    <style name="SheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="VelaDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogShape</item>
    </style>

    <style name="DialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Theme.Vela.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccentSeed">@color/accent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/VelaWindowAnim</item>
        <item name="bottomSheetDialogTheme">@style/VelaBottomSheet</item>
        <item name="materialAlertDialogTheme">@style/VelaDialog</item>
    </style>

    <style name="PlayerIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="PlayerBigIcon" parent="PlayerIcon">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="RoundedThumb">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ThemeSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- White player text with a soft shadow so it stays readable on bright scenes. -->
    <style name="PlayerText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#B3000000</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:shadowDy">1</item>
    </style>
</resources>
