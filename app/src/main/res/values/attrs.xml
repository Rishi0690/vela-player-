<resources>
    <!-- The seed color the user picked; the real UI colors come from the M3 palette built around it. -->
    <attr name="colorAccentSeed" format="color" />

    <!-- v2.11 glass system. Every theme overlay (values*/accents*.xml, generated) sets these, so one style works everywhere. -->
    <!-- Translucent fill for cards, chips, tonal buttons and fields (low-alpha white on dark, frosted white on light). -->
    <attr name="glassSurface" format="color" />
    <!-- Near-opaque glass for dialogs, sheets and popup menus (they float over content). -->
    <attr name="glassSurfaceStrong" format="color" />
    <!-- Hairline 1dp border on glass surfaces. -->
    <attr name="glassStroke" format="color" />
    <!-- Soft top sheen on glass panels. -->
    <attr name="glassHighlight" format="color" />
    <!-- Dark scrim behind floating panels. -->
    <attr name="glassScrim" format="color" />
    <!-- Faint hue of the theme for placeholders and selected glass. -->
    <attr name="glassTint" format="color" />
    <!-- v2.19 floating glass: fill + hairline for windows that float over a BLURRED screen (dialogs, sheets, popup
         menus on Android 12+). Light = frosted white ~82% with a darker ink hairline; dark = same as glassSurfaceStrong.
         Where the window behind is not blurred (Android 11-, blur off in battery saver, player) code and the pre-31
         styles use glassSurfaceStrong instead, so text never sits on see-through glass without blur. -->
    <attr name="glassFloat" format="color" />
    <attr name="glassFloatStroke" format="color" />
    <!-- v2.19: false in the player theme: its dialogs/popups keep the fixed dark glass and never blur live video. -->
    <attr name="glassBlurWindows" format="boolean" />

    <!-- v2.12 Midnight Glass design tokens (set per theme by the generated overlays). -->
    <!-- Glass level 2: grouped panels (settings groups, headers, floating clusters). Level 1 = glassSurface, level 3 = glassSurfaceStrong. -->
    <attr name="glassSurfaceElevated" format="color" />
    <!-- Atmosphere: the window background gradient (top darker → bottom tinted) and two soft radial glows. -->
    <attr name="atmoTop" format="color" />
    <attr name="atmoMid" format="color" />
    <attr name="atmoBottom" format="color" />
    <attr name="atmoGlowA" format="color" />
    <attr name="atmoGlowB" format="color" />
    <!-- Floating pill navigation: container glass, the selected pill, text on it, inactive text. -->
    <attr name="navContainer" format="color" />
    <attr name="navSelected" format="color" />
    <attr name="navOnSelected" format="color" />
    <attr name="navText" format="color" />
</resources>
