<?xml version="1.0" encoding="utf-8"?>
<!-- v2.14 list widget (Continue watching, Playlist / Favorites). The ListView is filled by WidgetListService;
     previewItems is only used by the in-app gallery preview (no adapter service there). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/wg_bg" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/wg_header" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ListView android:id="@+id/wgList" android:layout_width="match_parent" android:layout_height="match_parent"
                android:divider="@null" android:dividerHeight="0dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingBottom="6dp"
                android:clipToPadding="false" android:scrollbars="none" android:listSelector="@android:color/transparent" />
            <LinearLayout android:id="@+id/previewItems" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/wgEmpty" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
                <ImageView android:id="@+id/wgEmptyArt" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxHeight="90dp" android:scaleType="fitCenter" android:src="@drawable/art_luminous_forms" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wgEmptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:gravity="center" android:maxLines="3" android:textColor="#B3FFFFFF" android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
