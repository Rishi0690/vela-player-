<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/videoFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.hark.velaplayer.ZoomableVideoLayout
            android:id="@+id/videoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.media3.ui.SubtitleView
            android:id="@+id/subtitleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pipProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:max="1000"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="#44FFFFFF"
        app:trackThickness="3dp" />

    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <!-- Edge overlays: double-tap skip feedback and unlock buttons, kept near the screen edges (insets applied in code). -->
    <FrameLayout
        android:id="@+id/edgeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- v2.3: compact translucent skip chip; stays at its side (not moved to the bottom). -->
        <LinearLayout
            android:id="@+id/tapLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="40dp"
            android:alpha="0"
            android:background="@drawable/p22_status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/tapLeftIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rewind"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tapLeftText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@android:color/white"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- v2.3: compact translucent skip chip; stays at its side (not moved to the bottom). -->
        <LinearLayout
            android:id="@+id/tapRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="40dp"
            android:alpha="0"
            android:background="@drawable/p22_status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/tapRightIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_fast_forward"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tapRightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@android:color/white"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Unlock buttons on both sides (inside the inset-padded overlay so they clear notches). -->
        <com.hark.velaplayer.ShadowImageButton
            android:id="@+id/btnUnlock"
            style="@style/PlayerBigIcon"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="Unlock screen"
            android:src="@drawable/ic_lock_open"
            android:visibility="gone" />

        <com.hark.velaplayer.ShadowImageButton
            android:id="@+id/btnUnlockRight"
            style="@style/PlayerBigIcon"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="Unlock screen"
            android:src="@drawable/ic_lock_open"
            android:visibility="gone" />
    </FrameLayout>

    <!-- v2.2: skip feedback inside the picture-in-picture window (PiP rewind/forward buttons). -->
    <TextView
        android:id="@+id/p22PipSeek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/p22_status_bg"
        android:fontFeatureSettings="tnum"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@android:color/white"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <!-- v2.15: the big glass boxes behind the top bar and bottom dock were removed; the scrims keep icons readable. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnBack" style="@style/PlayerIcon" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" />

<TextView
                android:id="@+id/titleText"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/shuffleBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Shuffle play is on"
                android:src="@drawable/ic_shuffle"
                android:visibility="gone"
                app:tint="?attr/colorPrimary" />

            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnFocus" style="@style/PlayerIcon" android:contentDescription="Focus Mode" android:src="@drawable/ic_focus" />
            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnBrowse" style="@style/PlayerIcon" android:contentDescription="Browse videos" android:src="@drawable/ic_video_library" />
            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnSubtitle" style="@style/PlayerIcon" android:contentDescription="Subtitles" android:src="@drawable/ic_subtitles" />
            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnAudio" style="@style/PlayerIcon" android:contentDescription="Audio" android:src="@drawable/ic_audiotrack" />
            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnMore" style="@style/PlayerIcon" android:contentDescription="Player settings" android:src="@drawable/ic_tune" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/centerControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnPrev" style="@style/PlayerBigIcon" android:layout_marginEnd="8dp" android:contentDescription="Previous video" android:src="@drawable/ic_skip_prev" />
            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnRewind" style="@style/PlayerBigIcon" android:layout_marginEnd="16dp" android:contentDescription="Rewind" android:src="@drawable/ic_rewind" />
            <com.hark.velaplayer.ShadowImageButton
                android:id="@+id/btnPlay"
                style="@style/PlayerBigIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_player_play"
                android:padding="18dp"
                android:contentDescription="Play"
                android:src="@drawable/ic_pause" />
            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnForward" style="@style/PlayerBigIcon" android:layout_marginStart="16dp" android:contentDescription="Fast forward" android:src="@drawable/ic_fast_forward" />
            <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnNext" style="@style/PlayerBigIcon" android:layout_marginStart="8dp" android:contentDescription="Next video" android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- v2.1: playback modes (shuffle / loop / auto-play next), compact and right-aligned above the timeline. -->
            <LinearLayout
                android:id="@+id/modeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnShuffle" style="@style/PlayerIcon" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="Shuffle" android:src="@drawable/ic_shuffle" />
                <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnLoop" style="@style/PlayerIcon" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="Loop" android:src="@drawable/ic_repeat" />
                <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnAutoNext" style="@style/PlayerIcon" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="Auto-play next" android:src="@drawable/ic_autoplay_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/positionText"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:text="0:00"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:fontFeatureSettings="tnum" />

                <com.hark.velaplayer.TimelineSeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="Timeline. Drag or tap to seek" />

                <TextView
                    android:id="@+id/durationText"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:text="--:--"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/p23ButtonRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnLock" style="@style/PlayerIcon" android:contentDescription="Lock screen" android:src="@drawable/ic_lock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeed"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    style="@style/Widget.Vela.PlayerPill"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Playback speed. Tap for speeds, press and hold for the slider"
                    android:text="1x"
                    android:textColor="@android:color/white"
                    app:icon="@drawable/ic_speed"
                    app:iconTint="@android:color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAspectLabel"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    style="@style/Widget.Vela.PlayerPill"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Change aspect ratio. Tap to cycle, long press for menu"
                    android:text="Fit"
                    android:textColor="@android:color/white"
                    app:icon="@drawable/ic_aspect"
                    app:iconTint="@android:color/white" />

                <Space
                    android:id="@+id/p23RowGap"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnRotate" style="@style/PlayerIcon" android:contentDescription="Rotate screen" android:src="@drawable/ic_screen_rotation" />
                <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnPip" style="@style/PlayerIcon" android:contentDescription="Picture in picture" android:src="@drawable/ic_pip" />
                <com.hark.velaplayer.ShadowImageButton android:id="@+id/btnLockRight" style="@style/PlayerIcon" android:contentDescription="Lock screen" android:src="@drawable/ic_lock" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seekPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="104dp"
            android:background="@drawable/bg_indicator"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/seekPreviewImage"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/seekPreviewTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>


    <!-- v2.3: the one playback message chip (brightness, volume/boost, speed, seeking, zoom, modes, notices).
         Bottom-centre below the timeline; exact position set in code (PlaybackChip + chipPlacement). Not clickable. -->
    <LinearLayout
        android:id="@+id/p23Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:alpha="0"
        android:background="@drawable/p22_status_bg"
        android:gravity="center_vertical"
        android:importantForAccessibility="yes"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/p23ChipIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:importantForAccessibility="no"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/p23ChipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxWidth="280dp"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@android:color/white"
            android:textSize="12.5sp" />

        <FrameLayout
            android:id="@+id/p23ChipTrack"
            android:layout_width="44dp"
            android:layout_height="3dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/p23_chip_track"
            android:visibility="gone">

            <View
                android:id="@+id/p23ChipFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/p23_chip_fill"
                android:scaleX="0" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/focusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_focus_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <View
            android:id="@+id/focusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_focus_dot" />

        <TextView
            android:id="@+id/focusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:text="Focus 0:00"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/focusGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:max="1000"
            android:visibility="gone"
            app:indicatorSize="16dp"
            app:trackColor="#44FFFFFF"
            app:trackThickness="2.5dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/breakCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/breakText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="340dp"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/breakKeep"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Keep going"
                android:textColor="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/breakPause"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Take a break" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:background="@drawable/bg_indicator"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="360dp"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <!-- v2.19.1: full error code + cause (tap or long-press copies it) -->
        <TextView
            android:id="@+id/errorDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.7"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="6"
            android:ellipsize="end"
            android:maxWidth="360dp"
            android:textColor="@android:color/white"
            android:textIsSelectable="false"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnErrorClose"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="Close" />

            <!-- v2.19.3: open this local file with the platform MediaPlayer (SystemPlayerActivity) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemEngine"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="System player"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry" />
        </LinearLayout>
    </LinearLayout>

    <!-- Playback speed popup -->
    <LinearLayout
        android:id="@+id/speedPanel"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="92dp"
        android:alpha="0"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_speed"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/speedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="1.00x"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speedNormalTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Normal"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/speedReset"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="1x"
                android:textColor="@android:color/white"
                android:contentDescription="Reset to normal speed"
                app:icon="@drawable/ic_replay"
                app:iconTint="@android:color/white" />

            <ImageButton
                android:id="@+id/speedClose"
                style="@style/PlayerIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Close speed control"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/speedSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Playback speed slider"
            android:stepSize="0.05"
            android:valueFrom="0.25"
            android:valueTo="4.0"
            android:value="1.0"
            app:labelBehavior="floating"
            app:thumbColor="?attr/colorPrimary"
            app:trackColorActive="?attr/colorPrimary"
            app:trackColorInactive="#44FFFFFF"
            app:tickVisible="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:alpha="0.6" android:text="0.25x" android:textColor="@android:color/white" android:textSize="11sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.6" android:text="4x" android:textColor="@android:color/white" android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/speedPresetScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/speedPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Quick video browser (slide-out drawer) -->
    <View
        android:id="@+id/browserScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#80000000"
        android:clickable="true"
        android:contentDescription="Close video list"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/browserPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_drawer"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/browserTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/browserSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.65"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/browserClose"
                style="@style/PlayerIcon"
                android:contentDescription="Close video list"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/browserScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipScopeAll"
                style="@style/VelaChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All videos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipScopeFolder"
                style="@style/VelaChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="This folder" />
        </com.google.android.material.chip.ChipGroup>

        <EditText
            android:id="@+id/browserSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="#AAFFFFFF"
            android:hint="Search videos"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="@android:color/white"
            android:textColorHint="#88FFFFFF"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browserList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/browserEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
