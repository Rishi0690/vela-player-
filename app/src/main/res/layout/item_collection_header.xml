<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.hark.velaplayer.StackedThumbLayout
            android:id="@+id/stack"
            android:layout_width="106dp"
            android:layout_height="62dp"
            android:layout_marginEnd="14dp"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedThumb" />
        </com.hark.velaplayer.StackedThumbLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayAll"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Play all"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            app:iconSize="18dp"
            app:iconPadding="6dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShuffle"
            style="@style/Widget.Vela.Glass.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/header_btn_gap"
            android:layout_weight="1"
            android:text="Shuffle"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            app:iconSize="18dp"
            app:iconPadding="6dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_shuffle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/l23BtnReorder"
            style="@style/Widget.Vela.Glass.Button.Tonal.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:checkable="true"
            android:contentDescription="Edit order"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:visibility="gone"
            app:icon="@drawable/l23_ic_drag_handle"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.Vela.Glass.Button.Tonal.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Add videos"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_playlist_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>
</LinearLayout>
