<?xml version="1.0" encoding="utf-8"?>
<!-- v2.11 theme gallery: live preview, appearance, sectioned theme grid, saved themes, custom color + Advanced. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back" app:title="Themes" />

    <androidx.core.widget.NestedScrollView android:scrollbars="vertical"
        android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="24dp">

            <!-- Live preview: the theme being looked at, in its real colors, before it is applied. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/previewCard" style="@style/Widget.Vela.Glass.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <com.hark.velaplayer.ThemePreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:contentDescription="Theme preview" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/previewName" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:ellipsize="end" android:maxLines="1" android:textAppearance="?attr/textAppearanceTitleMedium" />
                            <TextView android:id="@+id/previewState" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:alpha="0.7" android:textAppearance="?attr/textAppearanceBodySmall" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/swatches" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/ThemeSection" android:text="Appearance" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
                app:selectionRequired="true" app:singleSelection="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/modeLight" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Light" />
                <com.google.android.material.button.MaterialButton android:id="@+id/modeDark" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dark" />
                <com.google.android.material.button.MaterialButton android:id="@+id/modeSystem" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="System" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- v2.18: background photos live in their own screen (Settings › Appearance › Background too). -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBackground" style="@style/Widget.Vela.Glass.Button.Tonal.Icon"
                android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
                android:text="Background photo" app:icon="@drawable/ic_wallpaper" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:alpha="0.7"
                android:text="Tap a theme to preview it above. Tap it again, or press Apply, to use it everywhere."
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <!-- Sections (Glass Dark, Vivid, Warm, Cool, Light-friendly) are added here in code. -->
            <LinearLayout android:id="@+id/presetContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView style="@style/ThemeSection" android:text="Your saved themes" />
            <TextView android:id="@+id/customEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:alpha="0.7" android:text="Make a custom color below and tap Save to keep it here. Long-press a saved theme to edit, duplicate, rename or delete it." android:textAppearance="?attr/textAppearanceBodyMedium" />
            <LinearLayout android:id="@+id/customContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView style="@style/ThemeSection" android:id="@+id/customTitle" android:text="Custom color" />
            <TextView android:id="@+id/editingNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorPrimary" android:visibility="gone" />
            <com.hark.velaplayer.ColorPickerView android:id="@+id/picker" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hexLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:hint="HEX color" app:prefixText="#" app:startIconDrawable="@drawable/ic_palette">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hexInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:digits="0123456789abcdefABCDEF" android:imeOptions="actionDone" android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="6" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Palette generated from the one color: accent, container, secondary, tertiary, glass, background + contrast check. -->
            <LinearLayout android:id="@+id/genRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" />
            <TextView android:id="@+id/contrastNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:alpha="0.75" android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView android:id="@+id/limitNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:alpha="0.7" android:textAppearance="?attr/textAppearanceBodySmall" android:visibility="gone" />

            <!-- Advanced (collapsed by default): secondary accent and background/glass base. -->
            <LinearLayout android:id="@+id/advancedHeader" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_tune" app:tint="?attr/colorOnSurfaceVariant" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Advanced" android:textAppearance="?attr/textAppearanceTitleSmall" />
                <TextView android:id="@+id/advancedArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show" android:textColor="?attr/colorPrimary" android:textAppearance="?attr/textAppearanceLabelLarge" />
            </LinearLayout>
            <LinearLayout android:id="@+id/advancedBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Secondary accent" android:textAppearance="?attr/textAppearanceLabelLarge" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/secondaryRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="6dp" />
                </HorizontalScrollView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Background &amp; glass" android:textAppearance="?attr/textAppearanceLabelLarge" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup android:id="@+id/baseGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
                </HorizontalScrollView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:alpha="0.7"
                    android:text="Each role uses the closest matching tuned palette, so text always stays readable."
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnReset" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Reset to default (Pure Black Glass)" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Save theme" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnApply" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Apply" />
    </LinearLayout>
</LinearLayout>
