<?xml version="1.0" encoding="utf-8"?>
<!-- v2.14 Now Playing, square (2x2): full-bleed artwork with a baked-in scrim, title and a glowing play orb. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/wg_bg" />
    <ImageView android:id="@+id/npArt" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="Artwork" />
    <ImageView android:id="@+id/npEdge" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wg_stroke_r1" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:gravity="bottom" android:orientation="horizontal" android:padding="12dp">
        <LinearLayout android:id="@+id/npText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/npSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="11sp" android:letterSpacing="0.04" />
            <TextView android:id="@+id/npTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="14sp" />
        </LinearLayout>
        <FrameLayout android:id="@+id/npPlayWrap" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp">
            <ImageView android:id="@+id/npPlayBg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_circle" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/npPlay" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp"
                android:background="@drawable/wg_ripple_circle" android:src="@drawable/wgi_play" android:contentDescription="Play" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
