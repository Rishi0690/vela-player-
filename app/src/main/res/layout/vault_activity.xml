<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Lock screen: shown until authentication succeeds. -->
    <LinearLayout
        android:id="@+id/vaultLockPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/vaultLockToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close"
            app:title="" />

        <ScrollView
            android:id="@+id/vaultLockHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true" />
    </LinearLayout>

    <!-- Vault library: only populated while unlocked. -->
    <LinearLayout
        android:id="@+id/vaultContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/vaultToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close"
            app:title="Hidden Vault" />

        <TextView
            android:id="@+id/vaultNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="4dp"
            android:alpha="0.7"
            android:paddingHorizontal="4dp"
            android:text="@string/vault_not_encrypted"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <!-- v2.3: count + Play all / Shuffle / Edit order (item_collection_header is inflated in here). -->
        <FrameLayout
            android:id="@+id/vaultHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <HorizontalScrollView
            android:id="@+id/vaultFilterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/vaultFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip android:id="@+id/vaultFAll" style="@style/VelaChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="All" />
                <com.google.android.material.chip.Chip android:id="@+id/vaultFProgress" style="@style/VelaChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="In progress" />
                <com.google.android.material.chip.Chip android:id="@+id/vaultFUnwatched" style="@style/VelaChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unwatched" />
                <com.google.android.material.chip.Chip android:id="@+id/vaultFWatched" style="@style/VelaChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Watched" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vaultList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp" />

            <TextView
                android:id="@+id/vaultEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.75"
                android:gravity="center"
                android:padding="32dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/vaultAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Add videos"
        android:visibility="gone"
        app:icon="@drawable/ic_add" />
</FrameLayout>
