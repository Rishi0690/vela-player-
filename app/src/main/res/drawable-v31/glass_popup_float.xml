<?xml version="1.0" encoding="utf-8"?>
<!-- v2.19: app popup menus, overflow menus and dropdowns as floating glass: fill + 1dp hairline + soft top sheen,
     14dp corners (Tokens.RADIUS_S). Android 12+: frosted fill over the blurred screen (ThemedActivity adds the blur behind the popup window; if the system has blur off it swaps the @id/glass_fill layer back to glassSurfaceStrong).
     The player keeps glass_popup / glass_popup_dark (fixed dark, no blur). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/glass_fill">
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassFloat" />
            <stroke android:width="1dp" android:color="?attr/glassFloatStroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:height="32dp" android:gravity="top" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="13dp" android:topRightRadius="13dp" />
        </shape>
    </item>
</layer-list>
