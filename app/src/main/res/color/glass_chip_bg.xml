<?xml version="1.0" encoding="utf-8"?>
<!-- v2.11: glass chip fill. Checked = soft accent glass, otherwise translucent glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:alpha="0.06" android:color="?attr/colorOnSurface" />
    <item android:state_checked="true" android:alpha="0.22" android:color="?attr/colorPrimary" />
    <item android:color="?attr/glassSurface" />
</selector>
