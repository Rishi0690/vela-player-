<?xml version="1.0" encoding="utf-8"?>
<!-- v2.6: Android 12+ frosted look: the screen behind dialogs and sheets is blurred (when the phone allows window blur). -->
<resources>
    <style name="VelaDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogShape</item>
        <item name="android:windowAnimationStyle">@style/VelaDialogAnim</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">28dp</item>
        <item name="android:backgroundDimAmount">0.28</item>
    </style>

    <style name="VelaBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VelaBottomSheetStyle</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">24dp</item>
        <item name="android:backgroundDimAmount">0.25</item>
    </style>
</resources>
