<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ frosted glass: the screen behind dialogs and sheets is blurred (when the phone allows window blur).
     Static overlays only: the player uses the *Plain styles (no blur over live video). -->
<resources>
    <style name="VelaDialog" parent="VelaDialog.Base">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">20dp</item>
        <item name="android:backgroundDimAmount">0.30</item>
    </style>

    <style name="VelaBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VelaBottomSheetStyle</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">20dp</item>
        <item name="android:backgroundDimAmount">0.28</item>
    </style>
</resources>
