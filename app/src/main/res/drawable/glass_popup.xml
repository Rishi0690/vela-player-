<?xml version="1.0" encoding="utf-8"?>
<!-- v2.11: popup menus as glass: near-opaque tinted fill, hairline border, soft top sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassSurfaceStrong" />
            <stroke android:width="1dp" android:color="?attr/glassStroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
        </shape>
    </item>
</layer-list>
