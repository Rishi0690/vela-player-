<?xml version="1.0" encoding="utf-8"?>
<!-- v2.11: player glass panel: translucent dark (no per-frame blur over video), hairline border, soft top sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/player_glass" />
            <stroke android:width="1dp" android:color="@color/player_glass_stroke" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="48dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/player_glass_highlight" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="23dp" android:topRightRadius="23dp" />
        </shape>
    </item>
</layer-list>
