<?xml version="1.0" encoding="utf-8"?>
<!-- v2.16.2: Android 12+ picker preview background (Midnight Glass). Scales to whatever box the launcher's widget
     picker gives, so the preview never shows blank strips. Content images (wg_pv_*) are fitted on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="24dp" />
        <gradient android:angle="270" android:startColor="#FF060915" android:centerColor="#FF121637" android:endColor="#FF1F2458" /></shape></item>
    <item><shape><corners android:radius="24dp" />
        <gradient android:type="radial" android:centerX="0.14" android:centerY="0" android:gradientRadius="120%"
            android:startColor="#805B47C9" android:endColor="#005B47C9" /></shape></item>
    <item><shape><corners android:radius="24dp" />
        <gradient android:type="radial" android:centerX="0.95" android:centerY="1" android:gradientRadius="110%"
            android:startColor="#592F64C8" android:endColor="#002F64C8" /></shape></item>
    <item><shape><corners android:radius="24dp" />
        <gradient android:angle="270" android:startColor="#1FFFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" /></shape></item>
    <item><shape><corners android:radius="24dp" /><stroke android:width="1dp" android:color="#34FFFFFF" /></shape></item>
</layer-list>
