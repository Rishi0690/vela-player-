<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12: floating glass capsule for player control clusters (translucent dark, hairline, top sheen; never blurs video). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7A0A0C14" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="22dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="999dp" android:topRightRadius="999dp" />
        </shape>
    </item>
</layer-list>
