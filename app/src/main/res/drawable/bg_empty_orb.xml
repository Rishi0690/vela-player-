<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12: soft glass orb behind empty-state icons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="44dp" android:startColor="?attr/glassTint" android:endColor="?attr/glassSurface" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="?attr/glassStroke" />
        </shape>
    </item>
</layer-list>
