<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12: the floating dark-glass capsule around the home tabs (navContainer + hairline + top sheen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/navContainer" />
            <stroke android:width="1dp" android:color="?attr/glassStroke" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="?attr/glassHighlight" android:endColor="@android:color/transparent" />
            <corners android:topLeftRadius="999dp" android:topRightRadius="999dp" />
        </shape>
    </item>
</layer-list>
