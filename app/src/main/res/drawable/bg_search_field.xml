<?xml version="1.0" encoding="utf-8"?>
<!-- v2.16: search field — layered glass pill: elevated glass base, soft top reflection, hairline rim (theme attrs only). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassSurfaceElevated" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="999dp" android:topRightRadius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="?attr/glassStroke" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
