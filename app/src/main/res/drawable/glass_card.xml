<?xml version="1.0" encoding="utf-8"?>
<!-- v2.11: reusable glass card background (theme-aware). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassSurface" />
            <stroke android:width="1dp" android:color="?attr/glassStroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
