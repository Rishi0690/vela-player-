<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12 play/pause orb; v2.16.1: a soft dark halo + darker core under the glass so it stays readable on white/bright frames. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <layer-list>
            <!-- contrast halo: fades from a gentle shadow at the rim to nothing inside -->
            <item>
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="36dp"
                        android:startColor="#59000000" android:centerColor="#40000000" android:endColor="#00000000" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <solid android:color="#2E000000" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="40dp" android:centerY="0.3"
                        android:startColor="#47FFFFFF" android:endColor="#1FFFFFFF" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
            <!-- outer hairline so the edge is defined on bright frames -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <stroke android:width="1dp" android:color="#33000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
