<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12: the play/pause orb: frosted glass disc with a bright rim and a soft inner light. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="40dp" android:centerY="0.3"
                        android:startColor="#47FFFFFF" android:endColor="#1FFFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
