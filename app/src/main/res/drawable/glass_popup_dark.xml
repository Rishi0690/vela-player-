<?xml version="1.0" encoding="utf-8"?>
<!-- v2.11: player popup menus (fixed dark glass, no blur over video). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/player_glass" />
            <stroke android:width="1dp" android:color="@color/player_glass_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
