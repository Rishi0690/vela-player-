<?xml version="1.0" encoding="utf-8"?>
<!-- v2.13: multi-select ActionMode bar = floating level-3 glass capsule with hairline + top sheen (Midnight Glass).
     v2.19: floating hairline (darker ink in Light mode so the capsule edge reads on the pale backdrop). It stays
     level-3 opaque: it sits inside the activity window, where no blur is possible. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp" android:insetRight="8dp" android:insetTop="4dp" android:insetBottom="4dp">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="26dp" />
                <solid android:color="?attr/glassSurfaceStrong" />
                <stroke android:width="1dp" android:color="?attr/glassFloatStroke" />
            </shape>
        </item>
        <item android:bottom="24dp">
            <shape android:shape="rectangle">
                <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
                <gradient android:angle="270" android:startColor="?attr/glassHighlight" android:endColor="#00FFFFFF" />
            </shape>
        </item>
    </layer-list>
</inset>
